# Copy to .env. Supply the exact PostgreSQL image tag already on your machine.
# Find it with: docker image ls
# Example only: postgres:17 (do not use unless that exact image exists locally).
POSTGRES_IMAGE=
POSTGRES_USER=heart_rate
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=heart_rate_monitor
# Separate local port to avoid disturbing another PostgreSQL project.
POSTGRES_PORT=5433
# API connection host. Docker Compose publishes the database on this loopback address.
POSTGRES_HOST=127.0.0.1
